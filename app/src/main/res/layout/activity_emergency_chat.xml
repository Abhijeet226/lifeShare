<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="0dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <!-- Row 1: Back + Patient info + Blood Group -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/btn_chat_back"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="6dp"
                        android:src="@drawable/ic_arrow_back"
                        android:tint="#1E293B"
                        android:contentDescription="Back" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_chat_patient_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#0F172A"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:text="Emergency Coordination" />

                        <TextView
                            android:id="@+id/tv_chat_hospital_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#64748B"
                            android:textSize="12sp"
                            android:text="AIIMS Bhubaneswar" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_chat_blood_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_pill_urgent"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:text="O+" />
                </LinearLayout>

                <!-- Row 2: Live Navigation & Google Maps Action -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_chat_navigation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E8F0"
                    app:cardBackgroundColor="#F1F5F9">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_hospital_desk"
                            android:tint="@color/colorPrimary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_chat_distance_eta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#1E293B"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:text="Hospital Destination" />

                            <TextView
                                android:id="@+id/tv_chat_destination_address"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#64748B"
                                android:textSize="10sp"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:text="Sijua, Patrapada, Bhubaneswar" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_chat_navigate_maps"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:text="Navigate"
                            app:cornerRadius="18dp"
                            app:icon="@drawable/ic_navigation_arrow"
                            app:iconSize="14dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Status / ETA Action Bar -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:background="#F8FAFC">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip_action_on_way"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:textSize="11sp"
                    android:text="On My Way"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_navigation_arrow"
                    app:iconSize="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip_action_eta_10m"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:textSize="11sp"
                    android:text="ETA: 10 mins"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_timer_eta"
                    app:iconSize="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip_action_eta_20m"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:textSize="11sp"
                    android:text="ETA: 20 mins"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_timer_eta"
                    app:iconSize="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip_action_reached_gate"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:textSize="11sp"
                    android:text="Reached Gate"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_hospital_desk"
                    app:iconSize="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip_action_at_desk"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:textSize="11sp"
                    android:text="At Blood Bank Desk"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_verified_coordinator"
                    app:iconSize="12dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Chat Messages Recycler -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_chat_messages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <ProgressBar
                android:id="@+id/pb_chat_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_chat_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:text="No messages yet. Send an update to coordinate."
                android:visibility="gone" />
        </FrameLayout>

        <!-- Bottom Input Bar -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="0dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <EditText
                    android:id="@+id/et_chat_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chat_bubble_received"
                    android:hint="Type coordination message..."
                    android:paddingStart="16dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="10dp"
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp"
                    android:maxLines="3" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_chat_send"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_chat_send"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="20dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
