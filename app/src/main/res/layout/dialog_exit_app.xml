<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/bg_grouped_container"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- App Logo / Exit Icon Badge -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/badge_blood_group">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_nav_home"
            app:tint="#FFFFFF" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Exit LifeShare?"
        android:textColor="?attr/colorOnSurface"
        android:textSize="19sp"
        android:textStyle="bold" />

    <!-- Explanatory Text -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Are you sure you want to close the app? You will continue receiving emergency blood alerts in the background."
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp" />

    <!-- Button Row (Stay & Exit) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <!-- Stay / Cancel Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_exit_stay"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Stay"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            app:cornerRadius="24dp"
            app:strokeColor="?attr/colorOutlineVariant" />

        <!-- Exit Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_exit_confirm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_gradient_button"
            android:text="Exit"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:backgroundTint="@null"
            app:cornerRadius="24dp" />

    </LinearLayout>

</LinearLayout>
