<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_donor_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="7dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/colorSurfaceContainer"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingVertical="18dp">

        <!-- Top Section: Blood Group Badge + Donor Details + Last Active Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Clickable Blood Group Badge -->
            <FrameLayout
                android:id="@+id/btn_badge_container"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/badge_blood_group"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_blood_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="O+"
                    android:textColor="@color/white"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Name, Location, Distance, Trust Badges -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

            <!-- Name & Twitter-style Verified Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/name_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Donor Name"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Twitter-style Verified Tick Badge -->
                <ImageView
                    android:id="@+id/iv_donor_verified_badge"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="5dp"
                    android:src="@drawable/ic_verified_badge"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- City Location Row -->
            <LinearLayout
                android:id="@+id/layout_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_location"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tv_donor_city"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Bhubaneswar, Odisha"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Dedicated Distance Row for High Prominence & Breathing Room -->
            <TextView
                android:id="@+id/tv_donor_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_pill_verify"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="~2.4 km away"
                android:textColor="@color/hospital_teal"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            </LinearLayout>

            <!-- Last Active Status Indicator -->
            <TextView
                android:id="@+id/tv_availability_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_available"
                android:paddingHorizontal="9dp"
                android:paddingVertical="4dp"
                android:text="Active recently"
                android:textColor="@color/status_available"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Expandable Dialer-Style Quick Contact Action Tray -->
        <LinearLayout
            android:id="@+id/layout_action_tray"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="12dp"
                app:dividerColor="?attr/colorOutlineVariant" />

            <!-- Seamless Pastel Circular Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- 1. Call Action -->
                <FrameLayout
                    android:id="@+id/btn_action_call"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_action_call"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_call"
                        app:tint="@color/call_blue" />
                </FrameLayout>

                <!-- 2. SMS Action -->
                <FrameLayout
                    android:id="@+id/btn_action_sms"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="24dp"
                    android:background="@drawable/bg_action_sms"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_sms"
                        app:tint="@color/sms_orange" />
                </FrameLayout>

                <!-- 3. WhatsApp Action -->
                <FrameLayout
                    android:id="@+id/btn_action_whatsapp"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="24dp"
                    android:background="@drawable/bg_action_whatsapp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_whatsapp"
                        app:tint="@color/whatsapp_green" />
                </FrameLayout>

                <!-- 4. Profile View Action -->
                <FrameLayout
                    android:id="@+id/btn_action_profile"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="24dp"
                    android:background="@drawable/bg_action_profile"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_profile"
                        app:tint="@color/colorPrimary" />
                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>