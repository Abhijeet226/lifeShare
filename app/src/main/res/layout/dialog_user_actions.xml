<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="16dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainer"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Top User Overview -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_dialog_user_blood"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/badge_blood_group"
                android:gravity="center"
                android:text="O+"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_dialog_user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User Full Name"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_dialog_user_contact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="email@example.com • +91 9800000000"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_dialog_user_role_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_verify"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="DONOR"
                android:textColor="?attr/colorPrimary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="?attr/colorOutlineVariant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:text="ACCOUNT STATUS CONTROL"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Status Action Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_action_activate"
                style="@style/Widget.LifeShare.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="Active"
                android:textColor="@color/status_available"
                android:textSize="12sp"
                app:cornerRadius="22dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_action_suspend"
                style="@style/Widget.LifeShare.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:text="Suspend"
                android:textColor="@color/cooldown_orange"
                android:textSize="12sp"
                app:cornerRadius="22dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_action_block"
                style="@style/Widget.LifeShare.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="Block"
                android:textColor="@color/status_busy"
                android:textSize="12sp"
                app:cornerRadius="22dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.05"
            android:text="ADMINISTRATIVE ACTIONS"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_action_promote_coordinator"
            style="@style/Widget.LifeShare.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:text="Assign to Hospital as Coordinator"
            android:textSize="13sp"
            app:cornerRadius="23dp"
            app:icon="@drawable/ic_hospital"
            app:iconPadding="8dp"
            app:iconSize="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_action_view_history"
            style="@style/Widget.LifeShare.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:text="View Lifetime Verifications / Donations"
            android:textSize="13sp"
            app:cornerRadius="23dp"
            app:icon="@drawable/ic_badge_trophy"
            app:iconPadding="8dp"
            app:iconSize="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_user_action_cancel"
            style="@style/Widget.LifeShare.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="18dp"
            android:text="Done"
            android:textSize="13sp"
            app:cornerRadius="23dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
