<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/bg_grouped_container"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Top Badge & Blood Group -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/badge_blood_group">

        <TextView
            android:id="@+id/tv_modal_blood_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="O+"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Name & Donor ID -->
    <TextView
        android:id="@+id/tv_modal_donor_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Donor Name"
        android:textColor="?attr/colorOnSurface"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_modal_donor_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="OD-LS-982011 • Voluntary Donor"
        android:textColor="?attr/colorPrimary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Info Grid Details Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input_field"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- City / Location -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Region / City"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_modal_donor_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bhubaneswar, Odisha"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            app:dividerColor="?attr/colorOutlineVariant" />

        <!-- Gender & Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Gender / Status"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_modal_donor_gender_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Male • Active Donor"
                android:textColor="@color/status_available"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            app:dividerColor="?attr/colorOutlineVariant" />

        <!-- Mobile Phone -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Contact Number"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_modal_donor_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+91 9820112233"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Quick Contact Icon Actions (Call, SMS, WhatsApp, Share) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Call Icon Button -->
        <FrameLayout
            android:id="@+id/btn_modal_call"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_action_call"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_call"
                app:tint="@color/call_blue" />
        </FrameLayout>

        <!-- SMS Icon Button -->
        <FrameLayout
            android:id="@+id/btn_modal_sms"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_action_sms"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_sms"
                app:tint="@color/sms_orange" />
        </FrameLayout>

        <!-- WhatsApp Icon Button -->
        <FrameLayout
            android:id="@+id/btn_modal_whatsapp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_action_whatsapp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_whatsapp"
                app:tint="@color/whatsapp_green" />
        </FrameLayout>

        <!-- Share Icon Button -->
        <FrameLayout
            android:id="@+id/btn_modal_share"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_action_share"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_share"
                app:tint="@color/colorPrimary" />
        </FrameLayout>

    </LinearLayout>

    <!-- Done / Dismiss Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_close_donor_modal"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_gradient_button"
        android:text="Close"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:backgroundTint="@null"
        app:cornerRadius="23dp" />

</LinearLayout>
