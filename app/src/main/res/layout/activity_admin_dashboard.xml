<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".AdminDashboardActivity">

    <!-- Main Pull-to-Refresh & Scrollable Content Area -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_admin"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_admin_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="100dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. Completely Flat Top Header (Scrolls Naturally With Content) -->
                <LinearLayout
                    android:id="@+id/layout_admin_top_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_admin_top_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Admin Console"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_admin_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="LifeShare Operations Hub"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Switch to Donor App Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_switch_to_donor"
                        style="@style/Widget.LifeShare.Button.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:paddingHorizontal="10dp"
                        android:text="Donor View"
                        android:textSize="11sp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_switch_mode"
                        app:iconPadding="4dp"
                        app:iconSize="14dp" />

                    <!-- Scan QR to Onboard Coordinator Button -->
                    <FrameLayout
                        android:id="@+id/btn_admin_scan_qr"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_action_circular_neutral"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_qr_scan"
                            app:tint="?attr/colorOnSurface" />
                    </FrameLayout>

                    <!-- Profile Avatar Icon Button -->
                    <FrameLayout
                        android:id="@+id/btn_admin_profile"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_action_circular_neutral"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/iv_admin_profile_avatar"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_profile"
                            app:tint="?attr/colorOnSurface" />
                    </FrameLayout>
                </LinearLayout>

                <!-- 2. Operational Overview Metrics (4 Cards) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="SYSTEM METRICS"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <!-- Total Users -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="?attr/colorSurfaceContainer"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total Users"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_stat_users"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="--"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Active Donors -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="?attr/colorSurfaceContainer"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Active Donors"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_stat_donors"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="--"
                                android:textColor="#2E7D32"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <!-- Hospitals -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="?attr/colorSurfaceContainer"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hospitals"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_stat_hospitals"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="--"
                                android:textColor="@color/hospital_teal"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Verified Donations -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="?attr/colorSurfaceContainer"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Donations"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_stat_donations"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="--"
                                android:textColor="@color/colorPrimary"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- 3. Section Title & Action Button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_admin_current_section_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="User Directory"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_admin_add_hospital"
                        style="@style/Widget.LifeShare.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="+ Add Hospital"
                        android:textSize="11sp"
                        android:visibility="gone"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <!-- Search Input Bar -->
                <FrameLayout
                    android:id="@+id/layout_admin_search_bar"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_field">

                    <EditText
                        android:id="@+id/et_admin_search"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="Search by name, email, or phone..."
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:paddingHorizontal="14dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp" />
                </FrameLayout>

                <!-- Skeleton Loading Placeholders -->
                <LinearLayout
                    android:id="@+id/layout_admin_skeleton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        app:cardBackgroundColor="?attr/colorSurfaceContainer"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <View
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="@drawable/bg_skeleton_placeholder" />
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">
                                    <View
                                        android:layout_width="140dp"
                                        android:layout_height="16dp"
                                        android:background="@drawable/bg_skeleton_placeholder" />
                                    <View
                                        android:layout_width="180dp"
                                        android:layout_height="12dp"
                                        android:layout_marginTop="6dp"
                                        android:background="@drawable/bg_skeleton_placeholder" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        app:cardBackgroundColor="?attr/colorSurfaceContainer"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <View
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="@drawable/bg_skeleton_placeholder" />
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">
                                    <View
                                        android:layout_width="160dp"
                                        android:layout_height="16dp"
                                        android:background="@drawable/bg_skeleton_placeholder" />
                                    <View
                                        android:layout_width="120dp"
                                        android:layout_height="12dp"
                                        android:layout_marginTop="6dp"
                                        android:background="@drawable/bg_skeleton_placeholder" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        app:cardBackgroundColor="?attr/colorSurfaceContainer"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <View
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="@drawable/bg_skeleton_placeholder" />
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">
                                    <View
                                        android:layout_width="130dp"
                                        android:layout_height="16dp"
                                        android:background="@drawable/bg_skeleton_placeholder" />
                                    <View
                                        android:layout_width="150dp"
                                        android:layout_height="12dp"
                                        android:layout_marginTop="6dp"
                                        android:background="@drawable/bg_skeleton_placeholder" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Dynamic Item Container -->
                <LinearLayout
                    android:id="@+id/container_admin_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

                <!-- Empty State Indicator -->
                <LinearLayout
                    android:id="@+id/layout_admin_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_empty_state"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tv_admin_empty_message"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="No records found"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- ================= FLOATING BOTTOM NAVIGATION BAR ================= -->
    <LinearLayout
        android:id="@+id/card_admin_floating_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_floating_bottom_bar"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp">

        <!-- Tab 1: Users -->
        <LinearLayout
            android:id="@+id/tab_nav_users"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <FrameLayout
                android:id="@+id/pill_nav_users"
                android:layout_width="48dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_tab_indicator_active">

                <ImageView
                    android:id="@+id/iv_nav_users"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_profile"
                    app:tint="@color/colorPrimary" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_nav_users"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Users"
                android:textColor="@color/colorPrimary"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 2: Hospitals -->
        <LinearLayout
            android:id="@+id/tab_nav_hospitals"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <FrameLayout
                android:id="@+id/pill_nav_hospitals"
                android:layout_width="48dp"
                android:layout_height="28dp">

                <ImageView
                    android:id="@+id/iv_nav_hospitals"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_hospital"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_nav_hospitals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Hospitals"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Tab 3: Emergencies -->
        <LinearLayout
            android:id="@+id/tab_nav_emergencies"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <FrameLayout
                android:id="@+id/pill_nav_emergencies"
                android:layout_width="48dp"
                android:layout_height="28dp">

                <ImageView
                    android:id="@+id/iv_nav_emergencies"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_emergency"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_nav_emergencies"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="SOS"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Tab 4: Audit -->
        <LinearLayout
            android:id="@+id/tab_nav_audit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <FrameLayout
                android:id="@+id/pill_nav_audit"
                android:layout_width="48dp"
                android:layout_height="28dp">

                <ImageView
                    android:id="@+id/iv_nav_audit"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_settings"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_nav_audit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Audit"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
