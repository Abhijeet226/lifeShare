<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".CoordinatorVerificationActivity">

    <!-- Main Pull-to-Refresh & Scrollable Content Area -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_coord_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="100dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. Completely Flat Top Header (Scrolls Naturally With Content) -->
                <LinearLayout
                    android:id="@+id/layout_coord_top_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_coord_top_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Coordinator Desk"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_coord_hospital_sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Hospital Verification Desk"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Create Hospital Emergency SOS Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_coord_post_sos"
                        style="@style/Widget.LifeShare.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="6dp"
                        android:paddingHorizontal="10dp"
                        android:text="+ SOS"
                        android:textSize="11sp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_emergency_sos"
                        app:iconPadding="4dp"
                        app:iconSize="14dp" />

                    <!-- Schedule Donation Drive / Camp Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_coord_schedule_camp"
                        style="@style/Widget.LifeShare.Button.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="6dp"
                        android:paddingHorizontal="10dp"
                        android:text="+ Camp"
                        android:textSize="11sp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_hospital"
                        app:iconPadding="4dp"
                        app:iconSize="13dp" />

                    <!-- Switch to Donor App Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_coord_switch_to_donor"
                        style="@style/Widget.LifeShare.Button.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:paddingHorizontal="10dp"
                        android:text="Donor View"
                        android:textSize="11sp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_switch_mode"
                        app:iconPadding="4dp"
                        app:iconSize="14dp" />

                    <!-- Profile Avatar Icon Button -->
                    <FrameLayout
                        android:id="@+id/btn_coordinator_profile"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_action_circular_neutral"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/iv_coord_profile_avatar"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_profile"
                            app:tint="?attr/colorOnSurface" />
                    </FrameLayout>
                </LinearLayout>

                <!-- 2. Fast-Track QR Scanner Action Card (Visible in Queue tab) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_coord_scanner_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Physical Donor Verification Desk"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_coord_summary_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Checking queue status..."
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_scan_donor_qr"
                                style="@style/Widget.LifeShare.Button.Primary"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1.3"
                                android:text="Scan Donor QR"
                                android:textSize="12.5sp"
                                app:cornerRadius="12dp"
                                app:icon="@drawable/ic_qr_scan"
                                app:iconGravity="textStart"
                                app:iconPadding="6dp"
                                app:iconSize="16dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_coord_enroll_walkin"
                                style="@style/Widget.LifeShare.Button.Tonal"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:text="+ Walk-In"
                                android:textSize="12.5sp"
                                app:cornerRadius="12dp"
                                app:icon="@drawable/ic_verified_user"
                                app:iconGravity="textStart"
                                app:iconPadding="6dp"
                                app:iconSize="16dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. Section Title -->
                <TextView
                    android:id="@+id/tv_coord_section_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Arrived Donors Waiting"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Skeleton Loading Placeholders -->
                <LinearLayout
                    android:id="@+id/layout_coord_skeleton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        app:cardBackgroundColor="?attr/colorSurfaceContainer"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <View
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="@drawable/bg_skeleton_placeholder" />
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">
                                    <View
                                        android:layout_width="140dp"
                                        android:layout_height="16dp"
                                        android:background="@drawable/bg_skeleton_placeholder" />
                                    <View
                                        android:layout_width="180dp"
                                        android:layout_height="12dp"
                                        android:layout_marginTop="6dp"
                                        android:background="@drawable/bg_skeleton_placeholder" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        app:cardBackgroundColor="?attr/colorSurfaceContainer"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <View
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="@drawable/bg_skeleton_placeholder" />
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">
                                    <View
                                        android:layout_width="160dp"
                                        android:layout_height="16dp"
                                        android:background="@drawable/bg_skeleton_placeholder" />
                                    <View
                                        android:layout_width="120dp"
                                        android:layout_height="12dp"
                                        android:layout_marginTop="6dp"
                                        android:background="@drawable/bg_skeleton_placeholder" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Dynamic Item Container -->
                <LinearLayout
                    android:id="@+id/container_pending_donors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

                <!-- Empty State Indicator -->
                <LinearLayout
                    android:id="@+id/layout_coord_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_empty_state"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tv_coord_empty_message"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="No donors currently waiting in queue"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- ================= FLOATING BOTTOM NAVIGATION BAR ================= -->
    <LinearLayout
        android:id="@+id/card_coord_floating_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_floating_bottom_bar"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <!-- Tab 1: Queue -->
        <LinearLayout
            android:id="@+id/tab_coord_queue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <FrameLayout
                android:id="@+id/pill_coord_queue"
                android:layout_width="48dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_tab_indicator_active">

                <ImageView
                    android:id="@+id/iv_coord_queue"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_qr_scan"
                    app:tint="@color/colorPrimary" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_coord_queue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Queue"
                android:textColor="@color/colorPrimary"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 2: Emergencies -->
        <LinearLayout
            android:id="@+id/tab_coord_emergencies"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <FrameLayout
                android:id="@+id/pill_coord_emergencies"
                android:layout_width="48dp"
                android:layout_height="28dp">

                <ImageView
                    android:id="@+id/iv_coord_emergencies"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_emergency"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_coord_emergencies"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="SOS"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Tab 3: History -->
        <LinearLayout
            android:id="@+id/tab_coord_history"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <FrameLayout
                android:id="@+id/pill_coord_history"
                android:layout_width="48dp"
                android:layout_height="28dp">

                <ImageView
                    android:id="@+id/iv_coord_history"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_badge_trophy"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_coord_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="History"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
