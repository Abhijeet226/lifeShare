<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_system_event"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_system_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_timer_eta"
            android:tint="#B45309"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tv_chat_system_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#92400E"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="Donor Abhijeet is on the way (ETA: 15 mins • 4.5 km)" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_chat_system_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#94A3B8"
        android:textSize="10sp"
        android:text="10:48 AM" />
</LinearLayout>
