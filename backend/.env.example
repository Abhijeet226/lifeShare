PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/lifeshare?retryWrites=true&w=majority
JWT_SECRET=your_secure_jwt_secret_key_here
CERT_SECRET=your_secure_certificate_hmac_secret_here

# ================================================================
# 1. EMAIL OTP CONFIGURATION (Gmail, Brevo, SendGrid, Outlook)
# ================================================================
# For Gmail: Use a 16-character "App Password" from your Google Account:
# Security -> 2-Step Verification -> App Passwords
SMTP_SERVICE=gmail
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_FROM="LifeShare Blood Bank" <your_email@gmail.com>

# For Custom SMTP (e.g., Hostinger, SendGrid, Amazon SES, Brevo):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false

# ================================================================
# 2. SMS OTP CONFIGURATION (Fast2SMS, Twilio, 2Factor.in)
# ================================================================
# Option A: Fast2SMS (Instant SMS delivery in India - https://www.fast2sms.com)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Option B: Twilio (Global SMS delivery - https://www.twilio.com/console)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Option C: 2Factor.in (India SMS)
# TWO_FACTOR_API_KEY=your_2factor_api_key_here

# ================================================================
# 3. FIREBASE CLOUD MESSAGING (FCM) PUSH NOTIFICATIONS
# ================================================================
# Download your service account JSON key from Firebase Console:
# Project Settings -> Service Accounts -> "Generate New Private Key"
# Save file to: backend/config/serviceAccountKey.json and set path below:
FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json

# OR paste the raw JSON string directly:
# FIREBASE_SERVICE_ACCOUNT='{"type": "service_account", "project_id": "...", ...}'
